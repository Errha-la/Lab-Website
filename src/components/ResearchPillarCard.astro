---
import PillarIcon from './PillarIcon.astro';

interface Props {
  titleZh: string;
  titleEn: string;
  descZh: string;
  descEn: string;
  /** 1/2/3 — selects the matching pillar icon (see PillarIcon.astro). */
  index?: number;
}

const { titleZh, titleEn, descZh, descEn, index } = Astro.props;
---

{/* Single card only — the parent page owns the grid/stack (e.g. grid-cols-1 md:grid-cols-3) so this stacks full-width on mobile without horizontal scroll. */}
<div class="w-full rounded-xl border border-brand-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
  {(index === 1 || index === 2 || index === 3) && (
    <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-brand-900">
      <PillarIcon pillar={index} />
    </span>
  )}
  {/* Font size only steps up to text-lg at xl, once the 3-column grid (lg:grid-cols-3 on the parent) has given the card enough width for the longest pillar title to stay on one line without overflowing. */}
  <h3 class="mt-4 whitespace-nowrap text-base font-bold text-brand-900 xl:text-lg">{titleZh}</h3>
  <p class="text-sm font-medium text-brand-500">{titleEn}</p>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">{descZh}</p>
  <p class="mt-2 text-xs leading-relaxed text-slate-400">{descEn}</p>
</div>
