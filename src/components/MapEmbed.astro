---
// Reusable Google Maps embed (no API key required) showing the lab's
// location. Used by the homepage contact summary, and reused as-is by the
// Contact page in a later phase — keep this generic, not homepage-specific.
interface Props {
  /** Extra classes applied to the outer wrapper (e.g. width/margin utilities). */
  className?: string;
  /** iframe height, any valid CSS length. Default '300'. */
  height?: string;
  /** Search query passed to Google Maps. Defaults to the lab's campus location. */
  query?: string;
  /** Accessible title for the iframe. */
  title?: string;
}

const {
  className = '',
  height = '300',
  query = '國立臺灣科技大學 華夏校區',
  title = 'Lab location map',
} = Astro.props;

const src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
---

<div class:list={['overflow-hidden rounded-2xl border border-brand-100 shadow-sm', className]}>
  <iframe
    src={src}
    width="100%"
    height={height}
    style="border:0; display:block;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={title}
  ></iframe>
</div>
