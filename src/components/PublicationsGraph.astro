---
// Phase 4 — Publications graph view.
// Renders a force-directed graph of papers as an inline SVG, laid out by a small
// vanilla-JS physics simulation (no charting library — see the client script below).
import { type TagCategory } from '../data/tags';

interface GraphPaper {
  title: string;
  authors: { name: string; is_corresponding: boolean }[];
  year: number;
  month: number;
  venue: string;
  type: string;
  doi_url?: string;
  tags: string[]; // flattened slugs across all 4 categories
}

interface Props {
  papers: GraphPaper[];
}

const { papers } = Astro.props;

// Kept in sync (by intent, not by import) with the hues CATEGORY_COLORS in
// src/data/tags.ts implies for HTML badges — those are Tailwind class strings
// and can't be used as raw SVG fill/stroke values, so this component owns its
// own hex palette for the same four categories.
const CATEGORY_HEX: Record<TagCategory, string> = {
  domain: '#2563eb', // blue
  method: '#16a34a', // green
  topic: '#9333ea', // purple
  tech: '#d97706', // amber
};

const categoryLabels: Record<TagCategory, { zh: string; en: string }> = {
  domain: { zh: '研究領域', en: 'Domain' },
  method: { zh: '研究方法', en: 'Method' },
  topic: { zh: '主題', en: 'Topic' },
  tech: { zh: '技術', en: 'Technology' },
};
const categoryOrder: TagCategory[] = ['domain', 'method', 'topic', 'tech'];

const graphData = papers.map((p) => ({
  title: p.title,
  authors: p.authors,
  year: p.year,
  month: p.month,
  venue: p.venue,
  type: p.type,
  doi_url: p.doi_url ?? null,
  tags: p.tags,
}));
---

<div class="w-full">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-600">
    {
      categoryOrder.map((cat) => (
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-full" style={`background-color:${CATEGORY_HEX[cat]}`} />
          {categoryLabels[cat].zh} <span class="text-slate-400">{categoryLabels[cat].en}</span>
        </span>
      ))
    }
    <span class="inline-flex items-center gap-1.5">
      <span class="inline-block h-3 w-3 rounded-full bg-slate-400" />
      無標籤 <span class="text-slate-400">Untagged</span>
    </span>
  </div>
  <p class="mt-2 max-w-3xl text-xs leading-relaxed text-slate-500">
    連線代表論文間共享的研究方法/主題/技術，群聚越密集代表該領域累積的研究越多
    <span class="block text-slate-400">
      Lines represent shared research methods/topics/techniques between papers — denser clusters indicate deeper
      research accumulation in that area.
    </span>
  </p>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-[1fr_280px]" data-pub-graph-root>
    <div class="w-full overflow-hidden rounded-xl border border-brand-100 bg-white p-2">
      <svg
        id="pub-graph-svg"
        viewBox="0 0 800 560"
        preserveAspectRatio="xMidYMid meet"
        class="h-auto w-full aspect-square md:aspect-auto"
        role="img"
        aria-label="論文關聯圖 Publications relationship graph"
      >
        <g id="pub-graph-edges"></g>
        <g id="pub-graph-nodes"></g>
      </svg>
    </div>

    <div
      id="pub-graph-detail"
      class="rounded-xl border border-brand-100 bg-brand-50/50 p-4 text-sm text-slate-600 lg:self-start"
    >
      點選節點查看論文詳情
      <span class="mt-1 block text-xs text-slate-400">Click a node to view paper details.</span>
    </div>
  </div>
</div>

<script type="application/json" id="pub-graph-data" is:inline set:html={JSON.stringify(graphData)} />

<script>
  import { TAGS } from '../data/tags';

  const CATEGORY_HEX: Record<string, string> = {
    domain: '#2563eb',
    method: '#16a34a',
    topic: '#9333ea',
    tech: '#d97706',
  };
  const NEUTRAL_HEX = '#94a3b8';
  const CATEGORY_ORDER = ['domain', 'method', 'topic', 'tech'];
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const DESKTOP_WIDTH = 800;
  const DESKTOP_HEIGHT = 560;

  interface GraphPaper {
    title: string;
    authors: { name: string; is_corresponding: boolean }[];
    year: number;
    month: number;
    venue: string;
    type: string;
    doi_url: string | null;
    tags: string[];
  }

  interface SimNode {
    id: number;
    paper: GraphPaper;
    category: string | null;
    tagLabel: string | null;
    x: number;
    y: number;
    vx: number;
    vy: number;
  }

  interface DragState {
    id: number;
    pointerId: number;
    startClientX: number;
    startClientY: number;
    moved: boolean;
  }

  interface SimEdge {
    source: number;
    target: number;
    weight: number;
    category: string | null;
  }

  function escapeHtml(str: string): string {
    return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  }

  function init() {
    const dataEl = document.getElementById('pub-graph-data');
    const edgesLayer = document.getElementById('pub-graph-edges');
    const nodesLayer = document.getElementById('pub-graph-nodes');
    const detailPanel = document.getElementById('pub-graph-detail');
    if (!dataEl || !edgesLayer || !nodesLayer) return;

    const papers: GraphPaper[] = JSON.parse(dataEl.textContent || '[]');
    if (papers.length === 0) return;

    const svgEl = document.getElementById('pub-graph-svg') as SVGSVGElement | null;
    const graphRoot = document.querySelector('[data-pub-graph-root]') as HTMLElement | null;
    let compactLayout = typeof window.matchMedia === 'function' && window.matchMedia('(max-width: 767px)').matches;
    let WIDTH = compactLayout ? 480 : DESKTOP_WIDTH;
    let HEIGHT = compactLayout ? 480 : DESKTOP_HEIGHT;
    svgEl?.setAttribute('viewBox', `0 0 ${WIDTH} ${HEIGHT}`);

    const syncGraphViewport = () => {
      if (!svgEl || !graphRoot) return;
      const containerWidth = graphRoot.getBoundingClientRect().width;
      if (compactLayout) {
        svgEl.style.height = `${Math.max(300, Math.min(480, Math.round(containerWidth)))}px`;
      } else {
        svgEl.style.height = '';
      }
    };
    syncGraphViewport();

    // Picks one representative tag to both color and *label* a node with, so the
    // graph shows what research topic each paper belongs to at a glance (rather
    // than a year, which says nothing about the knowledge clusters).
    function primaryTagInfo(tags: string[]): { slug: string; category: string; zh: string } | null {
      for (const cat of CATEGORY_ORDER) {
        const slug = tags.find((s) => TAGS[s]?.category === cat);
        if (slug) return { slug, category: cat, zh: TAGS[slug].zh };
      }
      return null;
    }

    let cx = WIDTH / 2;
    let cy = HEIGHT / 2;

    // Seed positions on a ring around the center so the simulation starts
    // spread out rather than from a single overlapping point.
    const nodes: SimNode[] = papers.map((p, i) => {
      const angle = (i / papers.length) * Math.PI * 2;
      const ringRadius = Math.min(WIDTH, HEIGHT) * 0.32;
      const tagInfo = primaryTagInfo(p.tags);
      return {
        id: i,
        paper: p,
        category: tagInfo?.category ?? null,
        tagLabel: tagInfo?.zh ?? null,
        x: cx + Math.cos(angle) * ringRadius + (Math.random() - 0.5) * 20,
        y: cy + Math.sin(angle) * ringRadius + (Math.random() - 0.5) * 20,
        vx: 0,
        vy: 0,
      };
    });

    // Edge = any pair of papers sharing >=1 tag (across all 4 categories).
    // Weight = number of shared tags; category = the category that contributed
    // the most shared tags, used to color the edge.
    const edges: SimEdge[] = [];
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const tagsA = nodes[i].paper.tags;
        const tagsB = new Set(nodes[j].paper.tags);
        let weight = 0;
        const sharedByCategory: Record<string, number> = {};
        for (const slug of tagsA) {
          if (tagsB.has(slug)) {
            weight++;
            const cat = TAGS[slug]?.category;
            if (cat) sharedByCategory[cat] = (sharedByCategory[cat] || 0) + 1;
          }
        }
        if (weight > 0) {
          let dominantCat: string | null = null;
          let max = 0;
          for (const [cat, count] of Object.entries(sharedByCategory)) {
            if (count > max) {
              max = count;
              dominantCat = cat;
            }
          }
          edges.push({ source: i, target: j, weight, category: dominantCat });
        }
      }
    }

    // --- Live force-directed simulation (Obsidian-style: an ongoing rAF loop
    // with an alpha/cooling schedule, à la d3-force) ---
    let REPULSION = compactLayout ? 9000 : 14000; // scale force constants with the logical graph viewport
    const SPRING_K = 0.02;
    let BASE_LEN = compactLayout ? 120 : 170;
    let LEN_PER_WEIGHT = compactLayout ? 16 : 22; // more shared tags -> shorter rest length -> tighter clustering
    let MIN_LEN = compactLayout ? 34 : 46;
    const CENTER_K = 0.012;
    const DAMPING = 0.82;
    let MARGIN = compactLayout ? 24 : 34;
    const SETTLE_ITERATIONS = 300; // used only for the reduced-motion one-shot settle

    const reducedMotion =
      typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // id of the node currently pinned under the pointer while being dragged, if any.
    // Forces still act on every other node normally; the pinned node's position is
    // driven directly by the pointer instead of by integration.
    let draggingId: number | null = null;

    // One physics pass: accumulate repulsion + spring + centering forces (scaled by
    // the current alpha, like d3-force) into each node's velocity, then integrate.
    function physicsTick(alpha: number) {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const ni = nodes[i];
          const nj = nodes[j];
          let dx = nj.x - ni.x;
          let dy = nj.y - ni.y;
          let distSq = dx * dx + dy * dy;
          if (distSq < 1) {
            dx = Math.random() - 0.5;
            dy = Math.random() - 0.5;
            distSq = 1;
          }
          const dist = Math.sqrt(distSq);
          const force = (REPULSION / distSq) * alpha;
          const fx = (dx / dist) * force;
          const fy = (dy / dist) * force;
          if (ni.id !== draggingId) {
            ni.vx -= fx;
            ni.vy -= fy;
          }
          if (nj.id !== draggingId) {
            nj.vx += fx;
            nj.vy += fy;
          }
        }
      }

      for (const e of edges) {
        const ni = nodes[e.source];
        const nj = nodes[e.target];
        const dx = nj.x - ni.x;
        const dy = nj.y - ni.y;
        const dist = Math.max(Math.sqrt(dx * dx + dy * dy), 1);
        const restLength = Math.max(MIN_LEN, BASE_LEN - e.weight * LEN_PER_WEIGHT);
        const force = (dist - restLength) * SPRING_K * alpha;
        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;
        if (ni.id !== draggingId) {
          ni.vx += fx;
          ni.vy += fy;
        }
        if (nj.id !== draggingId) {
          nj.vx -= fx;
          nj.vy -= fy;
        }
      }

      for (const n of nodes) {
        if (n.id === draggingId) {
          // Pinned: position is set directly by the pointer handler, not by physics.
          n.vx = 0;
          n.vy = 0;
          continue;
        }
        n.vx += (cx - n.x) * CENTER_K * alpha;
        n.vy += (cy - n.y) * CENTER_K * alpha;
        n.vx *= DAMPING;
        n.vy *= DAMPING;
        n.x += n.vx;
        n.y += n.vy;
        n.x = Math.min(WIDTH - MARGIN, Math.max(MARGIN, n.x));
        n.y = Math.min(HEIGHT - MARGIN, Math.max(MARGIN, n.y));
      }
    }

    // --- Render ---
    let NODE_R = compactLayout ? 17 : 20;

    const edgeEls = edges.map((edge) => {
      const line = document.createElementNS(SVG_NS, 'line');
      const ni = nodes[edge.source];
      const nj = nodes[edge.target];
      line.setAttribute('x1', String(ni.x));
      line.setAttribute('y1', String(ni.y));
      line.setAttribute('x2', String(nj.x));
      line.setAttribute('y2', String(nj.y));
      line.setAttribute('stroke', (edge.category && CATEGORY_HEX[edge.category]) || NEUTRAL_HEX);
      line.setAttribute('stroke-width', String(1 + edge.weight * 1.2));
      line.setAttribute('stroke-opacity', '0.35');
      edgesLayer.appendChild(line);
      return { el: line, edge };
    });

    const nodeEls = nodes.map((node) => {
      const g = document.createElementNS(SVG_NS, 'g');
      g.setAttribute('transform', `translate(${node.x}, ${node.y})`);
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      const tagLabelFull = node.tagLabel ?? '未分類 Untagged';
      g.setAttribute('aria-label', `${node.paper.title} — ${tagLabelFull} (${node.paper.year})`);
      (g.style as CSSStyleDeclaration).cursor = 'pointer';
      // Prevent the browser from hijacking a pointerdown-on-node as a page
      // scroll/pinch gesture on touch devices, so dragging works there too.
      (g.style as CSSStyleDeclaration).touchAction = 'none';

      const circle = document.createElementNS(SVG_NS, 'circle');
      circle.setAttribute('r', String(NODE_R));
      circle.setAttribute('fill', (node.category && CATEGORY_HEX[node.category]) || NEUTRAL_HEX);
      circle.setAttribute('stroke', '#ffffff');
      circle.setAttribute('stroke-width', '2');
      g.appendChild(circle);

      // Label shows the paper's primary research topic (not the year) so
      // clusters read as "what field is this" at a glance — the year still
      // shows up in the hover tooltip and the click-through detail panel.
      const rawLabel = node.tagLabel ?? '—';
      const labelText = rawLabel.length > 4 ? rawLabel.slice(0, 4) : rawLabel;
      const label = document.createElementNS(SVG_NS, 'text');
      label.setAttribute('text-anchor', 'middle');
      label.setAttribute('dy', '3.5');
      label.setAttribute('font-size', compactLayout ? '12' : '9');
      label.setAttribute('fill', '#ffffff');
      label.setAttribute('font-weight', '600');
      (label.style as CSSStyleDeclaration).pointerEvents = 'none';
      label.textContent = labelText;
      g.appendChild(label);

      const titleEl = document.createElementNS(SVG_NS, 'title');
      titleEl.textContent = `${node.paper.title} — ${tagLabelFull} (${node.paper.year})`;
      g.appendChild(titleEl);

      nodesLayer.appendChild(g);

      return { el: g, circle, label, node };
    });

    // Pushes the current node/edge x,y values out to the SVG DOM. Called once
    // per animation frame while the simulation is live, plus once synchronously
    // per pointer move while dragging (so the dragged node tracks the cursor
    // even in the reduced-motion path, where no rAF loop is running).
    function render() {
      edgeEls.forEach(({ el, edge }) => {
        const ni = nodes[edge.source];
        const nj = nodes[edge.target];
        el.setAttribute('x1', String(ni.x));
        el.setAttribute('y1', String(ni.y));
        el.setAttribute('x2', String(nj.x));
        el.setAttribute('y2', String(nj.y));
      });
      nodeEls.forEach(({ el, node }) => {
        el.setAttribute('transform', `translate(${node.x}, ${node.y})`);
      });
    }

    function applyResponsiveLayout() {
      const nextCompactLayout =
        typeof window.matchMedia === 'function' && window.matchMedia('(max-width: 767px)').matches;
      if (nextCompactLayout === compactLayout) {
        syncGraphViewport();
        return;
      }

      const previousWidth = WIDTH;
      const previousHeight = HEIGHT;
      const previousCx = cx;
      const previousCy = cy;
      compactLayout = nextCompactLayout;
      WIDTH = compactLayout ? 480 : DESKTOP_WIDTH;
      HEIGHT = compactLayout ? 480 : DESKTOP_HEIGHT;
      cx = WIDTH / 2;
      cy = HEIGHT / 2;
      REPULSION = compactLayout ? 9000 : 14000;
      BASE_LEN = compactLayout ? 120 : 170;
      LEN_PER_WEIGHT = compactLayout ? 16 : 22;
      MIN_LEN = compactLayout ? 34 : 46;
      MARGIN = compactLayout ? 24 : 34;
      NODE_R = compactLayout ? 17 : 20;

      svgEl?.setAttribute('viewBox', `0 0 ${WIDTH} ${HEIGHT}`);
      nodes.forEach((node) => {
        node.x = cx + (node.x - previousCx) * (WIDTH / previousWidth);
        node.y = cy + (node.y - previousCy) * (HEIGHT / previousHeight);
        node.vx *= WIDTH / previousWidth;
        node.vy *= HEIGHT / previousHeight;
        node.x = Math.min(WIDTH - MARGIN, Math.max(MARGIN, node.x));
        node.y = Math.min(HEIGHT - MARGIN, Math.max(MARGIN, node.y));
      });
      nodeEls.forEach(({ circle, label }) => {
        circle.setAttribute('r', String(NODE_R));
        label.setAttribute('font-size', compactLayout ? '12' : '9');
      });
      syncGraphViewport();
      render();
      reheat(0.4);
    }

    const graphResizeObserver = typeof ResizeObserver === 'function' && graphRoot
      ? new ResizeObserver(applyResponsiveLayout)
      : null;
    if (graphResizeObserver && graphRoot) graphResizeObserver.observe(graphRoot);
    window.addEventListener('resize', applyResponsiveLayout);

    // --- Alpha-cooled simulation loop (D3-force-style) ---
    // Runs as an ongoing requestAnimationFrame loop so the graph feels "alive"
    // (nodes drift and settle) instead of popping straight to a static layout.
    // Alpha starts hot and decays every tick; once it drops below ALPHA_MIN the
    // loop stops scheduling further frames so an idle graph doesn't keep
    // burning CPU forever. Dragging a node reheats alpha so the rest of the
    // graph visibly reacts, then it cools back down again.
    const ALPHA_DECAY = 0.98;
    const ALPHA_MIN = 0.005;
    let alpha = 1;
    let rafId: number | null = null;

    function stepSimulation() {
      physicsTick(alpha);
      alpha *= ALPHA_DECAY;
      render();
      rafId = alpha > ALPHA_MIN ? requestAnimationFrame(stepSimulation) : null;
    }

    function reheat(target: number) {
      if (reducedMotion) return; // no continuous loop in reduced-motion mode
      alpha = Math.max(alpha, target);
      if (rafId === null) {
        rafId = requestAnimationFrame(stepSimulation);
      }
    }

    if (reducedMotion) {
      // Settle once synchronously (same math as the live loop, held at full
      // strength) and render a single static frame — no ongoing rAF loop.
      for (let i = 0; i < SETTLE_ITERATIONS; i++) physicsTick(1);
      render();
    } else {
      rafId = requestAnimationFrame(stepSimulation);
    }

    // --- Dragging (pointer-based: works for mouse, touch, and pen alike) ---
    const DRAG_THRESHOLD = 4; // px of pointer travel before a press counts as a drag, not a click
    let dragState: DragState | null = null;

    function clientToSvgPoint(clientX: number, clientY: number): { x: number; y: number } {
      if (!svgEl) return { x: clientX, y: clientY };
      const pt = svgEl.createSVGPoint();
      pt.x = clientX;
      pt.y = clientY;
      const ctm = svgEl.getScreenCTM();
      if (!ctm) return { x: clientX, y: clientY };
      const p = pt.matrixTransform(ctm.inverse());
      return { x: p.x, y: p.y };
    }

    // Adjacency map for neighbor highlighting on click.
    const neighborsOf = new Map<number, Set<number>>();
    nodes.forEach((n) => neighborsOf.set(n.id, new Set()));
    edges.forEach((e) => {
      neighborsOf.get(e.source)?.add(e.target);
      neighborsOf.get(e.target)?.add(e.source);
    });

    function formatAuthors(paper: GraphPaper): string {
      return paper.authors.map((a) => a.name + (a.is_corresponding ? '*' : '')).join('、');
    }

    function renderDetail(paper: GraphPaper) {
      if (!detailPanel) return;
      const monthStr = String(paper.month).padStart(2, '0');
      const doiLink = paper.doi_url
        ? `<a href="${escapeHtml(paper.doi_url)}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-xs font-medium text-brand-600 underline underline-offset-2 hover:text-brand-800">查看論文 View Paper →</a>`
        : '';
      detailPanel.innerHTML = `
        <h3 class="text-sm font-bold leading-snug text-brand-900">${escapeHtml(paper.title)}</h3>
        <p class="mt-2 text-xs text-slate-600">${escapeHtml(formatAuthors(paper))}</p>
        <p class="mt-2 text-xs text-slate-400">${escapeHtml(paper.venue)} · ${paper.year}/${monthStr}</p>
        ${doiLink}
      `;
    }

    function selectNode(id: number) {
      const neighbors = neighborsOf.get(id) || new Set<number>();
      nodeEls.forEach(({ el, circle, node }) => {
        const isSelected = node.id === id;
        const isNeighbor = neighbors.has(node.id);
        (el.style as CSSStyleDeclaration).opacity = isSelected || isNeighbor ? '1' : '0.25';
        circle.setAttribute('stroke-width', isSelected ? '4' : isNeighbor ? '3' : '2');
        circle.setAttribute('stroke', isSelected ? '#102a43' : '#ffffff');
      });
      edgeEls.forEach(({ el, edge }) => {
        const connected = edge.source === id || edge.target === id;
        el.setAttribute('stroke-opacity', connected ? '0.9' : '0.08');
      });
      const paper = nodes.find((n) => n.id === id)?.paper;
      if (paper) renderDetail(paper);
    }

    nodeEls.forEach(({ el, node }) => {
      const activate = () => selectNode(node.id);

      // Keyboard activation stays independent of the pointer/drag machinery
      // below — dragging is a mouse/touch enhancement layered on top of it,
      // not a replacement.
      el.addEventListener('keydown', (ev) => {
        const key = (ev as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          ev.preventDefault();
          activate();
        }
      });

      el.addEventListener('pointerdown', (ev) => {
        const pev = ev as PointerEvent;
        if (pev.button != null && pev.button !== 0) return; // left click / primary touch only
        pev.preventDefault();
        pev.stopPropagation();
        // Pointer capture is an enhancement (keeps the drag tracking this node
        // even if the pointer slips off it mid-move) — if the browser refuses
        // it for any reason, the drag/click logic below must still run.
        try {
          el.setPointerCapture(pev.pointerId);
        } catch {
          /* ignore — dragging still works without capture */
        }
        dragState = {
          id: node.id,
          pointerId: pev.pointerId,
          startClientX: pev.clientX,
          startClientY: pev.clientY,
          moved: false,
        };
        draggingId = node.id;
        reheat(0.3); // wake the graph back up so the rest reacts to the drag live
      });

      el.addEventListener('pointermove', (ev) => {
        if (!dragState || dragState.id !== node.id) return;
        const pev = ev as PointerEvent;
        const dx = pev.clientX - dragState.startClientX;
        const dy = pev.clientY - dragState.startClientY;
        if (!dragState.moved && Math.hypot(dx, dy) > DRAG_THRESHOLD) dragState.moved = true;

        const p = clientToSvgPoint(pev.clientX, pev.clientY);
        node.x = Math.min(WIDTH - MARGIN, Math.max(MARGIN, p.x));
        node.y = Math.min(HEIGHT - MARGIN, Math.max(MARGIN, p.y));
        node.vx = 0;
        node.vy = 0;

        // In reduced-motion mode there's no running rAF loop to pick this up,
        // so push the moved node/edges to the DOM immediately.
        if (reducedMotion) render();
      });

      const endDrag = (ev: Event) => {
        if (!dragState || dragState.id !== node.id) return;
        const pev = ev as PointerEvent;
        const wasDrag = dragState.moved;
        dragState = null;
        draggingId = null;
        try {
          if (el.hasPointerCapture(pev.pointerId)) el.releasePointerCapture(pev.pointerId);
        } catch {
          /* ignore */
        }
        // Only a press that never moved past the threshold counts as a
        // click/tap that opens the detail panel — anything else was a drag.
        if (!wasDrag) activate();
      };
      el.addEventListener('pointerup', endDrag);
      el.addEventListener('pointercancel', endDrag);
    });

    // Shared filter integration — publications.astro's toolbar dispatches this
    // event on window whenever the tag/type filter state changes, so both the
    // list view and this graph react to a single source of truth.
    function applyGraphFilter(detail: { tag: string | null; type: string } | undefined) {
      const tag = detail?.tag ?? null;
      const type = detail?.type ?? 'all';

      nodeEls.forEach(({ el, node }) => {
        const matchesTag = !tag || node.paper.tags.includes(tag);
        const matchesType = type === 'all' || node.paper.type === type;
        (el.style as CSSStyleDeclaration).display = matchesTag && matchesType ? '' : 'none';
        (el.style as CSSStyleDeclaration).opacity = '1';
      });
      edgeEls.forEach(({ el, edge }) => {
        const sourceVisible = (nodeEls[edge.source].el.style as CSSStyleDeclaration).display !== 'none';
        const targetVisible = (nodeEls[edge.target].el.style as CSSStyleDeclaration).display !== 'none';
        el.setAttribute('stroke-opacity', sourceVisible && targetVisible ? '0.35' : '0');
      });
      // Any active click-selection no longer applies once the visible set changes.
      nodeEls.forEach(({ circle }) => {
        circle.setAttribute('stroke-width', '2');
        circle.setAttribute('stroke', '#ffffff');
      });
    }

    window.addEventListener('pub:filterchange', ((ev: CustomEvent) => {
      applyGraphFilter(ev.detail);
    }) as EventListener);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
