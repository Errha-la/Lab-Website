---
import type { CollectionEntry } from 'astro:content';
import TagBadge from './TagBadge.astro';

// Accepts the `data` shape of a papers collection entry (pass `entry.data` for
// real content-collection entries, or an equivalent plain object).
type PaperData = CollectionEntry<'papers'>['data'];

interface Props {
  paper: PaperData;
}

const { paper } = Astro.props;
const { title, authors, year, month, type, venue, tags, doi_url } = paper;

const typeLabel: Record<string, { zh: string; en: string }> = {
  journal: { zh: '期刊', en: 'Journal' },
  conference: { zh: '研討會', en: 'Conference' },
  other: { zh: '其他', en: 'Other' },
};

const allTags = [...tags.domain, ...tags.method, ...tags.topic, ...tags.tech];

// Some papers (e.g. large multi-omics collaborations) list 20+ authors, which
// would otherwise dominate the card — show the first few and collapse the rest.
const AUTHOR_DISPLAY_LIMIT = 6;
const displayedAuthors = authors.length > AUTHOR_DISPLAY_LIMIT ? authors.slice(0, 3) : authors;
const hiddenAuthorCount = authors.length - displayedAuthors.length;
const fullAuthorList = authors.map((a) => a.name + (a.is_corresponding ? '*' : '')).join('、');
---

<article class="w-full rounded-xl border border-brand-100 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
  <h3 class="text-base font-bold leading-snug text-brand-900">{title}</h3>

  <p class="mt-2 text-sm text-slate-600" title={hiddenAuthorCount > 0 ? fullAuthorList : undefined}>
    {
      displayedAuthors.map((author, i) => (
        <>
          {i > 0 && '、'}
          {author.name}
          {author.is_corresponding && <sup class="text-accent-600">*</sup>}
        </>
      ))
    }
    {
      hiddenAuthorCount > 0 && (
        <span class="text-slate-400">
          {' '}等 {hiddenAuthorCount} 位 <span class="text-slate-300">et al.</span>
        </span>
      )
    }
  </p>

  <p class="mt-1 text-xs text-slate-400">
    {venue} · {year}/{String(month).padStart(2, '0')} · {typeLabel[type]?.zh ?? type}{' '}
    <span class="text-slate-300">{typeLabel[type]?.en ?? ''}</span>
  </p>

  {
    allTags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {allTags.map((t) => (
          <TagBadge tag={t} />
        ))}
      </div>
    )
  }

  {
    doi_url && (
      <a
        href={doi_url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block text-xs font-medium text-brand-600 underline underline-offset-2 hover:text-brand-800"
      >
        查看論文 View Paper →
      </a>
    )
  }
</article>
