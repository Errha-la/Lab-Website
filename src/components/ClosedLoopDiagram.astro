---
// Inline SVG diagram of the lab's "closed-loop smart manufacturing line" — the
// core-case architecture from the original planning doc: one top-level case,
// branching into the 4 research axes, converging back into a feedback loop.
// Lines draw themselves via stroke-dasharray/stroke-dashoffset once this
// section scrolls into view (fires once — see the script below), echoing the
// lighter-weight equivalent of illoca's scroll-scrubbed hand-drawing animation
// agreed on earlier, but as plain SVG + CSS transitions instead of a canvas
// frame sequence.
interface Axis {
  zh: string;
  en: string;
}

const AXES: Axis[] = [
  { zh: '生成式 AI 與 LLM', en: 'Generative AI & LLM' },
  { zh: '設備健康監測與預測性維修', en: 'EHM & PdM' },
  { zh: '電腦視覺與晶圓影像識別', en: 'Computer Vision' },
  { zh: '系統最佳化與智慧排程', en: 'Optimization & Scheduling' },
];

// Layout constants (viewBox units) — 4 boxes across, converging top and bottom.
const VB_W = 900;
const VB_H = 400;
const TOP_BOX = { x: 300, y: 12, w: 300, h: 52 };
const BOTTOM_BOX = { x: 300, y: 300, w: 300, h: 66 };
const AXIS_BOX_W = 200;
const AXIS_BOX_H = 76;
const AXIS_Y = 118;
const AXIS_GAP = 20;
const AXIS_START_X = (VB_W - (AXIS_BOX_W * 4 + AXIS_GAP * 3)) / 2;

const axisBoxes = AXES.map((axis, i) => ({
  ...axis,
  x: AXIS_START_X + i * (AXIS_BOX_W + AXIS_GAP),
  y: AXIS_Y,
}));

const topCenterX = TOP_BOX.x + TOP_BOX.w / 2;
const bottomCenterX = BOTTOM_BOX.x + BOTTOM_BOX.w / 2;
---

<div class="w-full" data-closed-loop-root>
  <svg
    viewBox={`0 0 ${VB_W} ${VB_H}`}
    preserveAspectRatio="xMidYMid meet"
    class="h-auto w-full"
    role="img"
    aria-label="閉環智慧生產線架構圖：核心案例分支為四大研究主軸，再匯聚為閉環回饋 Closed-loop smart manufacturing line: core case branching into 4 research axes, converging into closed-loop feedback"
  >
    {/* Lines: top box -> each axis box, drawn first */}
    <g data-loop-lines-top>
      {
        axisBoxes.map((box) => (
          <path
            d={`M ${topCenterX} ${TOP_BOX.y + TOP_BOX.h} L ${box.x + AXIS_BOX_W / 2} ${box.y}`}
            fill="none"
            stroke="#829ab1"
            stroke-width="2"
            data-loop-line
          />
        ))
      }
    </g>

    {/* Lines: each axis box -> bottom box, drawn second */}
    <g data-loop-lines-bottom>
      {
        axisBoxes.map((box) => (
          <path
            d={`M ${box.x + AXIS_BOX_W / 2} ${box.y + AXIS_BOX_H} L ${bottomCenterX} ${BOTTOM_BOX.y}`}
            fill="none"
            stroke="#829ab1"
            stroke-width="2"
            data-loop-line
          />
        ))
      }
    </g>

    {/* Top box: the core case */}
    <g data-loop-box class="loop-fade">
      <rect x={TOP_BOX.x} y={TOP_BOX.y} width={TOP_BOX.w} height={TOP_BOX.h} rx="8" fill="#102a43" />
      <text x={topCenterX} y={TOP_BOX.y + 22} text-anchor="middle" font-size="14" font-weight="700" fill="#ffffff">
        核心案例：閉環智慧生產線
      </text>
      <text x={topCenterX} y={TOP_BOX.y + 40} text-anchor="middle" font-size="10.5" fill="#bcccdc">
        Core Case: Closed-Loop Smart Manufacturing Line
      </text>
    </g>

    {/* 4 axis boxes */}
    {
      axisBoxes.map((box, i) => (
        <g data-loop-box data-loop-box-index={i} class="loop-fade">
          <rect
            x={box.x}
            y={box.y}
            width={AXIS_BOX_W}
            height={AXIS_BOX_H}
            rx="8"
            fill="#ffffff"
            stroke="#bcccdc"
            stroke-width="1.5"
          />
          <text
            x={box.x + AXIS_BOX_W / 2}
            y={box.y + 30}
            text-anchor="middle"
            font-size="13"
            font-weight="700"
            fill="#102a43"
          >
            {box.zh}
          </text>
          <text
            x={box.x + AXIS_BOX_W / 2}
            y={box.y + 50}
            text-anchor="middle"
            font-size="10.5"
            fill="#627d98"
          >
            {box.en}
          </text>
        </g>
      ))
    }

    {/* Bottom box: closed-loop feedback */}
    <g data-loop-box data-loop-box-final class="loop-fade">
      <rect
        x={BOTTOM_BOX.x}
        y={BOTTOM_BOX.y}
        width={BOTTOM_BOX.w}
        height={BOTTOM_BOX.h}
        rx="8"
        fill="#f59e0b"
      />
      <text x={bottomCenterX} y={BOTTOM_BOX.y + 24} text-anchor="middle" font-size="14" font-weight="700" fill="#ffffff">
        閉環回饋 Closed-Loop Feedback
      </text>
      <text x={bottomCenterX} y={BOTTOM_BOX.y + 43} text-anchor="middle" font-size="10.5" fill="#fffbeb">
        預防停機、調整參數、最佳化營運
      </text>
      <text x={bottomCenterX} y={BOTTOM_BOX.y + 58} text-anchor="middle" font-size="9.5" fill="#fef3c7">
        Prevent downtime, tune parameters, optimize operations
      </text>
    </g>
  </svg>
</div>

<style>
  [data-loop-line] {
    transition: stroke-dashoffset 0.7s ease-out;
  }
  .loop-fade {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }
  [data-closed-loop-root].is-visible .loop-fade {
    opacity: 1;
    transform: translateY(0);
  }
  [data-closed-loop-root].is-visible [data-loop-box-final] rect {
    animation: loop-pulse 1s ease-out 1.6s;
  }
  @keyframes loop-pulse {
    0% {
      filter: drop-shadow(0 0 0 rgba(245, 158, 11, 0.7));
    }
    50% {
      filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.55));
    }
    100% {
      filter: drop-shadow(0 0 0 rgba(245, 158, 11, 0));
    }
  }
</style>

<script>
  // Fires the draw-in animation once when the diagram scrolls into view.
  // Respects prefers-reduced-motion by skipping straight to the settled state
  // (same pattern used in PublicationsGraph.astro).
  function initClosedLoopDiagram(root: HTMLElement) {
    const lines = Array.from(root.querySelectorAll<SVGPathElement>('[data-loop-line]'));
    const topLines = Array.from(root.querySelectorAll<SVGPathElement>('[data-loop-lines-top] [data-loop-line]'));
    const bottomLines = Array.from(root.querySelectorAll<SVGPathElement>('[data-loop-lines-bottom] [data-loop-line]'));
    const boxes = Array.from(root.querySelectorAll<SVGGElement>('[data-loop-box]'));
    const topBox = boxes[0];
    const axisBoxes = boxes.slice(1, 5);
    const finalBox = boxes[5];

    const reducedMotion =
      typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Prep: set each line's dash pattern to its own full length so the
    // "draw" starts fully hidden regardless of the path's actual geometry.
    lines.forEach((line) => {
      const len = line.getTotalLength();
      line.style.strokeDasharray = String(len);
      line.style.strokeDashoffset = String(len);
    });

    if (reducedMotion) {
      root.classList.add('is-visible');
      lines.forEach((line) => (line.style.strokeDashoffset = '0'));
      return;
    }

    function play() {
      // 1. Top box fades in immediately (CSS handles this via .is-visible).
      root.classList.add('is-visible');

      // 2. Lines from the top box draw down to the 4 axis boxes, staggered.
      topLines.forEach((line, i) => {
        window.setTimeout(() => {
          line.style.strokeDashoffset = '0';
        }, 150 + i * 90);
      });

      // 3. Axis box labels land shortly after their line arrives (CSS
      // transition on all `.loop-fade` already starts with the shared
      // `is-visible` class, so stagger them individually via transition-delay).
      axisBoxes.forEach((box, i) => {
        (box as unknown as HTMLElement).style.transitionDelay = `${0.35 + i * 0.09}s`;
      });
      if (topBox) (topBox as unknown as HTMLElement).style.transitionDelay = '0s';

      // 4. Lines from the 4 axis boxes converge down to the feedback box.
      bottomLines.forEach((line, i) => {
        window.setTimeout(() => {
          line.style.strokeDashoffset = '0';
        }, 750 + i * 90);
      });

      // 5. Feedback box lands last, then pulses (pulse timing is in the CSS
      // keyframe's animation-delay above).
      if (finalBox) (finalBox as unknown as HTMLElement).style.transitionDelay = '1.1s';
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            play();
            observer.unobserve(root); // fire once — no replay on scroll bounce
          }
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(root);
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-closed-loop-root]').forEach(initClosedLoopDiagram);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
