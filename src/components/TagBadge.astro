---
import { TAGS, CATEGORY_COLORS } from '../data/tags';

interface Props {
  tag: string;
  lang?: 'zh' | 'en' | 'both';
}

const { tag, lang = 'zh' } = Astro.props;
const info = TAGS[tag];

const label = info ? (lang === 'en' ? info.en : lang === 'both' ? `${info.zh} / ${info.en}` : info.zh) : tag;
---

{
  info ? (
    <span class={`inline-flex items-center whitespace-nowrap rounded-full border px-2.5 py-0.5 text-xs font-medium ${CATEGORY_COLORS[info.category]}`}>
      {label}
    </span>
  ) : (
    <span class="inline-flex items-center whitespace-nowrap rounded-full border border-slate-300 bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">
      {label}
    </span>
  )
}
