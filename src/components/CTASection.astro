---
interface Props {
  titleZh: string;
  titleEn: string;
  bodyZh?: string;
  bodyEn?: string;
  ctaHref?: string;
  ctaZh?: string;
  ctaEn?: string;
}

const {
  titleZh,
  titleEn,
  bodyZh,
  bodyEn,
  ctaHref = '/join-us',
  ctaZh = '加入我們',
  ctaEn = 'Join Us',
} = Astro.props;
---

<section class="bg-brand-900">
  <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-white sm:text-3xl">{titleZh}</h2>
    <p class="mt-1 text-sm font-medium text-brand-300 sm:text-base">{titleEn}</p>

    {bodyZh && <p class="mt-4 leading-relaxed text-brand-100">{bodyZh}</p>}
    {bodyEn && <p class="mt-1 text-sm text-brand-400">{bodyEn}</p>}

    <a
      href={ctaHref}
      class="mt-8 inline-flex items-center justify-center rounded-full bg-accent-500 px-8 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-600"
    >
      {ctaZh} <span class="ml-1.5 text-xs font-normal text-accent-50">{ctaEn}</span>
    </a>
  </div>
</section>
