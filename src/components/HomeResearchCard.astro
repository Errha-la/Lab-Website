---
// Homepage-only "illoca-style" narrative teaser card: numbered, a short punchy
// tagline above the real axis title, one plain-language line, and a link into
// Publications pre-filtered by the most representative tag. Deliberately
// punchier/shorter than TechniqueCard.astro's full technique/application
// breakdown on the About page — this is a teaser, not the detailed version.
interface Props {
  index: number;
  tagline: string;
  titleZh: string;
  titleEn: string;
  descZh: string;
  descEn: string;
  tagSlug: string;
}

const { index, tagline, titleZh, titleEn, descZh, descEn, tagSlug } = Astro.props;
const paddedIndex = String(index).padStart(2, '0');
---

<div class="flex w-full flex-col rounded-xl border border-brand-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
  <span class="text-xs font-bold tracking-wide text-brand-300">{paddedIndex}</span>
  <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-accent-600">{tagline}</p>

  <h3 class="mt-3 text-base font-bold leading-snug text-brand-900">{titleZh}</h3>
  <p class="text-xs font-medium text-brand-400">{titleEn}</p>

  <p class="mt-3 text-sm leading-relaxed text-slate-600">{descZh}</p>
  <p class="mt-1 text-xs leading-relaxed text-slate-400">{descEn}</p>

  <a
    href={`/publications?tag=${tagSlug}`}
    class="mt-4 inline-flex items-center text-xs font-semibold text-brand-600 underline underline-offset-2 hover:text-brand-800"
  >
    查看相關論文 <span class="ml-1 text-brand-400">View Related Research</span> →
  </a>
</div>
