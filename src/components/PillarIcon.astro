---
// Line-style icon for one of the 3 RESEARCH_PILLARS (src/consts.ts), matching the
// restrained, single-color "engineering drawing" SVG style already used for the
// placeholder icons in Hero.astro / CTASection.astro (viewBox 0 0 24 24, stroke
// currentColor, stroke-width 1.5, no fills).
interface Props {
  /** 1 = AI Agent & Decision Support, 2 = Digital Twin & Real-World Deployment, 3 = Advanced Control & Closed-loop Manufacturing. */
  pillar: 1 | 2 | 3;
  class?: string;
}

const { pillar, class: className } = Astro.props;
---

{
  pillar === 1 && (
    // Chat/thought bubble merged with a branching decision tree — AI agent reasoning & decision support.
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={['h-10 w-10', className]}
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="11" rx="3" />
      <path d="M8 15 L8 19 L12 15" />
      <circle cx="12" cy="7.3" r="0.9" />
      <path d="M12 8.2 L12 10" />
      <path d="M12 10 L8.7 12.8" />
      <path d="M12 10 L15.3 12.8" />
      <circle cx="8.7" cy="12.8" r="0.9" />
      <circle cx="15.3" cy="12.8" r="0.9" />
    </svg>
  )
}

{
  pillar === 2 && (
    // Two overlapping cube outlines — a physical object and its digital-twin mirror.
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={['h-10 w-10', className]}
      aria-hidden="true"
    >
      <path d="M5.5 12 L11.5 12 L11.5 18 L5.5 18 Z M5.5 12 L7.5 10 L13.5 10 L11.5 12 M11.5 12 L13.5 10 L13.5 16 L11.5 18" />
      <path d="M9.5 8 L15.5 8 L15.5 14 L9.5 14 Z M9.5 8 L11.5 6 L17.5 6 L15.5 8 M15.5 8 L17.5 6 L17.5 12 L15.5 14" />
    </svg>
  )
}

{
  pillar === 3 && (
    // Closed feedback loop around a central process node — advanced control & closed-loop manufacturing.
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={['h-10 w-10', className]}
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="3" />
      <path d="M12 9 L12 7.5" />
      <path d="M15 12 L16.5 12" />
      <path d="M12 15 L12 16.5" />
      <path d="M9 12 L7.5 12" />
      <path d="M14.39 5.42 A7 7 0 1 1 9.61 5.42" />
      <path d="M9.61 5.42 L11.3 4.6 M9.61 5.42 L11.8 6.6" />
    </svg>
  )
}
