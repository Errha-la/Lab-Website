---
import { NAV_LINKS, JOIN_US_LINK, SITE_TITLE_ZH, SITE_TITLE_EN } from '../consts';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 border-b border-brand-100 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 shadow-sm">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex min-w-0 flex-col leading-tight">
        <span class="truncate text-base font-bold text-brand-900 sm:text-lg">{SITE_TITLE_ZH}</span>
        <span class="hidden truncate text-[11px] text-slate-500 sm:block sm:text-xs">{SITE_TITLE_EN}</span>
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Main navigation" class="hidden items-center gap-1 md:flex">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-center text-sm font-medium transition-colors',
                isActive(link.href)
                  ? 'bg-brand-100 text-brand-900'
                  : 'text-slate-600 hover:bg-brand-50 hover:text-brand-800',
              ]}
            >
              {link.zh}
              <span class="block text-[10px] font-normal text-slate-400">{link.en}</span>
            </a>
          ))
        }
        <a
          href={JOIN_US_LINK.href}
          class="ml-2 inline-flex items-center rounded-full bg-accent-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-600"
        >
          {JOIN_US_LINK.zh}
          <span class="ml-1 text-xs font-normal text-accent-50">{JOIN_US_LINK.en}</span>
        </a>
      </nav>

      <!-- Mobile: Join Us stays visible outside the hamburger so recruits find it in one tap -->
      <div class="flex shrink-0 items-center gap-2 md:hidden">
        <a
          href={JOIN_US_LINK.href}
          class="inline-flex items-center rounded-full bg-accent-500 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-600"
        >
          {JOIN_US_LINK.zh}
        </a>
        <button
          id="nav-toggle"
          type="button"
          aria-label="開啟選單 Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex items-center justify-center rounded-md p-2 text-slate-600 hover:bg-brand-50 hover:text-brand-900"
        >
          <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <nav id="mobile-menu" aria-label="Mobile navigation" class="hidden pb-4 md:hidden">
      <div class="flex flex-col gap-1">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium',
                isActive(link.href) ? 'bg-brand-100 text-brand-900' : 'text-slate-600 hover:bg-brand-50',
              ]}
            >
              {link.zh} <span class="text-xs text-slate-400">{link.en}</span>
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
