---
interface BilingualItem {
  zh: string;
  en: string;
}

interface Props {
  titleZh: string;
  titleEn: string;
  techniques: BilingualItem[];
  applications: BilingualItem[];
  /** 1/2/3/4 — shown as a small numbered badge, matching ResearchPillarCard. */
  index?: number;
}

const { titleZh, titleEn, techniques, applications, index } = Astro.props;
---

{/* Single card only — the parent page owns the grid (grid-cols-1 md:grid-cols-2) so this stacks full-width on mobile without horizontal scroll. */}
<div class="w-full rounded-xl border border-brand-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
  {index && (
    <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-900 text-sm font-bold text-white">
      {index}
    </span>
  )}
  <h3 class="mt-4 text-base font-bold text-brand-900 xl:text-lg">{titleZh}</h3>
  <p class="text-sm font-medium text-brand-500">{titleEn}</p>

  <div class="mt-5">
    <h4 class="text-xs font-bold uppercase tracking-wide text-brand-700">
      核心技術與方法 <span class="font-normal normal-case text-brand-300">Core Techniques</span>
    </h4>
    <ul class="mt-2 flex flex-col gap-1.5">
      {techniques.map((item) => (
        <li class="rounded-lg bg-brand-50 px-3 py-1.5">
          <p class="text-sm leading-snug text-slate-700">{item.zh}</p>
          <p class="text-xs leading-snug text-slate-400">{item.en}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-4">
    <h4 class="text-xs font-bold uppercase tracking-wide text-brand-700">
      關鍵應用與效益 <span class="font-normal normal-case text-brand-300">Key Applications</span>
    </h4>
    <ul class="mt-2 flex flex-col gap-1.5">
      {applications.map((item) => (
        <li class="rounded-lg bg-slate-50 px-3 py-1.5">
          <p class="text-sm leading-snug text-slate-700">{item.zh}</p>
          <p class="text-xs leading-snug text-slate-400">{item.en}</p>
        </li>
      ))}
    </ul>
  </div>
</div>
