---
import { ADDRESS_ZH, ADDRESS_EN, CONTACT_EMAIL, NAV_LINKS, JOIN_US_LINK, SITE_TITLE_ZH, SITE_TITLE_EN } from '../consts';

const year = new Date().getFullYear();
---

<footer class="bg-brand-900 text-brand-100">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-white">{SITE_TITLE_ZH}</p>
        <p class="text-xs text-brand-300">{SITE_TITLE_EN}</p>
        <p class="mt-4 text-xs leading-relaxed text-brand-200">{ADDRESS_ZH}</p>
        <p class="text-xs leading-relaxed text-brand-400">{ADDRESS_EN}</p>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="mt-2 inline-block text-xs text-accent-400 underline underline-offset-2 hover:text-accent-300"
        >
          {CONTACT_EMAIL}
        </a>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold text-white">
          快速連結 <span class="text-xs font-normal text-brand-400">Quick Links</span>
        </p>
        <ul class="space-y-1.5">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-brand-200 hover:text-white">
                  {link.zh} <span class="text-brand-400">/ {link.en}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={JOIN_US_LINK.href} class="text-xs font-semibold text-accent-400 hover:text-accent-300">
              {JOIN_US_LINK.zh} / {JOIN_US_LINK.en}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-brand-800 pt-4 text-center text-xs text-brand-400">
      &copy; {year} {SITE_TITLE_ZH} · {SITE_TITLE_EN}. All rights reserved.
    </div>
  </div>
</footer>
