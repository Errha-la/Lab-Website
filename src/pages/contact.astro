---
// Contact page — phase 4.
import BaseLayout from '../layouts/BaseLayout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { CONTACT_EMAIL, ADDRESS_ZH, ADDRESS_EN } from '../consts';
---

<BaseLayout title="聯絡我們 / Contact" description="聯絡先進製程與設備智能輔助實驗室 —— Email、地址與交通方式資訊。">
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
      <h1 class="text-3xl font-bold leading-tight text-brand-900 sm:text-4xl">
        聯絡我們 <span class="block text-lg font-normal text-brand-400 sm:inline sm:text-xl">Contact Us</span>
      </h1>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
        無論是研究合作、產學交流，或是想加入實驗室，歡迎與我們聯繫。
      </p>
      <p class="mt-1 text-sm text-slate-400">
        Whether it's research collaboration, industry partnership, or joining the lab, feel free to reach out.
      </p>
    </div>
  </section>

  <!-- 1. Email & Address -->
  <section class="mx-auto max-w-4xl px-4 pb-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-brand-100 p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-400">Email</h2>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="mt-2 inline-block break-all text-lg font-semibold text-brand-700 underline underline-offset-2 hover:text-brand-900"
        >
          {CONTACT_EMAIL}
        </a>
      </div>
      <div class="rounded-2xl border border-brand-100 p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-400">
          地址 <span class="normal-case text-brand-300">Address</span>
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700">{ADDRESS_ZH}</p>
        <p class="mt-1 text-xs leading-relaxed text-slate-400">{ADDRESS_EN}</p>
      </div>
    </div>
  </section>

  <!-- 2. Map embed -->
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-brand-900">
      地圖 <span class="text-base font-normal text-brand-400">Map</span>
    </h2>
    <div class="mt-6">
      <MapEmbed height="400" title="實驗室地圖位置 Lab location map" />
    </div>
  </section>

  <!-- 3. Transportation -->
  <section class="bg-brand-50/50">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-brand-900">
        交通方式 <span class="text-base font-normal text-brand-400">Getting Here</span>
      </h2>

      <div class="mt-6 space-y-4">
        <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold text-brand-900">
            捷運 <span class="text-sm font-normal text-brand-400">MRT</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            搭乘捷運中和新蘆線至「南勢角站」，4 號出口出站後騎乘 YouBike 約 4 分鐘，或步行約 10～15 分鐘可達校區。
          </p>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">
            Take the MRT Zhonghe–Xinlu Line to Nanshijiao Station. From Exit 4, it's about a 4-minute YouBike ride or
            a 10–15 minute walk to campus.
          </p>

          <h4 class="mt-4 text-sm font-semibold text-brand-800">
            免費接駁公車 <span class="text-xs font-normal text-brand-400">Free Shuttle Options</span>
          </h4>
          <ul class="mt-2 space-y-2 text-sm leading-relaxed text-slate-600">
            <li>
              新北市新巴士 F512 副線 — 南勢角站 4 號出口搭乘，每日上午 06:30、07:00～20:00 每整點一班
              <span class="mt-0.5 block text-xs text-slate-400">
                New Taipei New Bus F512 (branch line) — board at Exit 4, daily 06:30 &amp; 07:00–20:00 hourly
              </span>
            </li>
            <li>
              欣欣客運華夏專車 — 南勢角站 2 號出口搭乘，平日上午 06:28、06:46、07:08、07:35、07:52、08:08、08:25
              <span class="mt-0.5 block text-xs text-slate-400">
                Shin Shin Bus (Huaxia dedicated route) — board at Exit 2, weekday mornings at the times above
              </span>
            </li>
            <li>
              圓通雅筑接駁車 — 南勢角站 2 號出口搭乘，每日 06:30～10:00、16:00～20:30 約 15 分鐘一班
              <span class="mt-0.5 block text-xs text-slate-400">
                Yuantong Yazhu shuttle — board at Exit 2, daily 06:30–10:00 &amp; 16:00–20:30, roughly every 15 minutes
              </span>
            </li>
          </ul>

          <h4 class="mt-4 text-sm font-semibold text-brand-800">
            公車 <span class="text-xs font-normal text-brand-400">City Bus</span>
          </h4>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            最短路線為 275、207 路；亦可搭乘 242、249、670、895、241、796 等路線，下車後步行約 3～19 分鐘可達。
          </p>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">
            Shortest routes are Bus 275 / 207. Bus 242, 249, 670, 895, 241, or 796 also serve the area, with a 3–19
            minute walk from the nearest stop.
          </p>

          <p class="mt-3 text-xs text-slate-400">
            資料來源：
            <a
              href="https://hwahsia-campus.ntust.edu.tw/p/412-1119-11723.php?Lang=zh-tw"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-slate-600"
            >
              臺灣科技大學華夏校區辦公室 — 交通路線指引
            </a>
          </p>
        </div>

        <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold text-brand-900">
            開車 <span class="text-sm font-normal text-brand-400">Driving</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            走水源快速道路、環河路接 111 縣道至忠孝街，再轉工專路即達校區，車程約 17～20 分鐘。
          </p>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">
            Take the Shuiyuan Expressway, then Huanhe Rd. and County Road 111 to Zhongxiao St., turning onto Gongzhuan
            Rd. to reach campus — roughly a 17–20 minute drive.
          </p>
        </div>

        <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold text-brand-900">
            校內接駁車（校本部↔華夏校區） <span class="text-sm font-normal text-brand-400">Inter-Campus Shuttle</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            供本校教職員生使用，上下車地點為校本部圖書館前、華夏校區中正堂前；週一至週五上課日發車，例假日及國定假日不行駛。
          </p>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">
            For NTUST faculty, staff, and students only. Boarding points: in front of the Main Campus Library, and in
            front of Zhongzheng Hall at Huaxia Campus. Runs Monday–Friday on class days only.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            實際發車時刻表每學期另行公告，請以校方最新公告為準：
          </p>
          <p class="mt-2 text-xs text-slate-400">
            資料來源：
            <a
              href="https://www.general.ntust.edu.tw/p/406-1054-139606,r7.php?Lang=zh-tw"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-slate-600"
            >
              臺灣科技大學總務處公告 — 華夏校區交通接駁車班次表
            </a>
          </p>
        </div>

        <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
          <h3 class="text-base font-semibold text-brand-900">
            停車資訊 <span class="text-sm font-normal text-brand-400">Parking</span>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            停車資訊：詳情請洽實驗室。
          </p>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">
            Parking information: please contact the lab for details.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
