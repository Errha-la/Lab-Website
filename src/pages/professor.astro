---
// Phase 4 — Professor page.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import TagBadge from '../components/TagBadge.astro';
import PaperCard from '../components/PaperCard.astro';

const education = [
  {
    zh: '國立交通大學工業工程與管理學系博士 (2012)',
    en: 'Ph.D. in Industrial Engineering and Management, National Chiao Tung University, Taiwan',
  },
  {
    zh: '國立中正大學企業管理學系碩士 (2007)',
    en: 'Master of Science in Business Administration, National Chung Cheng University, Taiwan',
  },
  {
    zh: '國立臺灣師範大學圖文傳播學系學士 (2004)',
    en: 'Bachelor of Science in Graphic Arts Communication, National Taiwan Normal University, Taiwan',
  },
];

const experience = [
  {
    title_zh: '副教授',
    title_en: 'Associate Professor',
    org_zh: '國立臺灣科技大學',
    org_en: 'National Taiwan University of Science and Technology, Taiwan',
  },
  {
    title_zh: '助理教授',
    title_en: 'Assistant Professor',
    org_zh: '國立中興大學',
    org_en: 'National Chung Hsing University, Taiwan',
  },
  {
    title_zh: '助理教授',
    title_en: 'Assistant Professor',
    org_zh: '逢甲大學',
    org_en: 'Feng Chia University, Taiwan',
  },
  {
    title_zh: 'IT/全球製造資訊部門 Principal IT Applications Architect',
    title_en: 'Principal IT Applications Architect',
    org_zh: '戴樂格半導體有限公司',
    org_en: 'Dialog Semiconductor',
  },
  {
    title_zh: 'IT/巨量資料分析課 Principal Engineer',
    title_en: 'Principal Engineer',
    org_zh: '台灣積體電路製造股份有限公司',
    org_en: 'Taiwan Semiconductor Manufacturing Company (TSMC)',
  },
];

const researchTags = [
  'machine-learning',
  'deep-learning',
  'anomaly-detection',
  'predictive-maintenance',
  'defect-detection',
  'smart-manufacturing',
  'equipment-health-monitoring',
];

const allPapers = await getCollection('papers');
const representativePapers = allPapers
  .filter((p) => p.data.authors.some((a) => a.name.includes('Dang')))
  .sort((a, b) => {
    // featured papers first, then most recent
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return b.data.month - a.data.month;
  })
  .slice(0, 5);

const pageDescription = '鄧志峰 副教授（Jr-Fong Dang, Associate Professor）— 學經歷、研究領域與代表著作。';
---

<BaseLayout title="指導教授 / Professor" description={pageDescription}>
  {/* 1. 大頭照版位 + 姓名職稱 */}
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
      <div class="flex aspect-square w-40 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-brand-200 to-brand-400 sm:w-48">
        <span class="text-6xl font-bold text-white/90">鄧</span>
      </div>
      <div class="text-center sm:text-left">
        <h1 class="text-3xl font-bold text-brand-900">鄧志峰</h1>
        <p class="text-base text-brand-500">Jr-Fong Dang</p>
        <p class="mt-3 text-sm font-medium text-slate-600">副教授 Associate Professor</p>
        <p class="text-sm text-slate-400">National Taiwan University of Science and Technology</p>
      </div>
    </div>
  </section>

  {/* 2. 學歷 Education */}
  <section class="bg-brand-50/50">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-brand-900">
        學歷 <span class="text-base font-normal text-brand-400">Education</span>
      </h2>
      <ul class="mt-6 space-y-4">
        {
          education.map((edu) => (
            <li class="rounded-xl border border-brand-100 bg-white p-4 shadow-sm">
              <p class="text-sm font-bold text-brand-900">{edu.zh}</p>
              <p class="mt-1 text-xs text-slate-400">{edu.en}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 3. 經歷時間軸 Timeline */}
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-brand-900">
      經歷 <span class="text-base font-normal text-brand-400">Experience</span>
    </h2>
    <div class="mt-8">
      <Timeline items={experience} />
    </div>
  </section>

  {/* 4. 研究領域 tag */}
  <section class="bg-brand-50/50">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-brand-900">
        研究領域 <span class="text-base font-normal text-brand-400">Research Areas</span>
      </h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {researchTags.map((tag) => <TagBadge tag={tag} lang="both" />)}
      </div>
    </div>
  </section>

  {/* 5. 代表著作 */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-brand-900">
      代表著作 <span class="text-base font-normal text-brand-400">Representative Publications</span>
    </h2>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {representativePapers.map((paper) => <PaperCard paper={paper.data} />)}
    </div>
    <div class="mt-8 text-center">
      <a
        href="/publications"
        class="text-sm font-semibold text-brand-600 underline underline-offset-2 hover:text-brand-800"
      >
        查看完整論文列表 →
      </a>
    </div>
  </section>
</BaseLayout>
